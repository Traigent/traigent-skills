#!/bin/sh
# Starts the Traigent analytics MCP server (stdio) for the plugin's .mcp.json.
# Order: an installed console script, else uvx from PyPI, else a clear failure.
# Reads TRAIGENT_API_KEY / TRAIGENT_BACKEND_URL from the environment; writes nothing.
if command -v traigent-analytics-mcp >/dev/null 2>&1; then
  exec traigent-analytics-mcp
elif command -v uvx >/dev/null 2>&1; then
  exec uvx --from 'traigent[mcp,analytics]>=0.24.0' traigent-analytics-mcp
else
  echo 'traigent-analytics MCP: install traigent[mcp,analytics] or uv, then reconnect (see the traigent-analyze-results skill, Prerequisites)' >&2
  exit 127
fi
