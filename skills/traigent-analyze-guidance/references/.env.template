# Traigent — secrets. COPY THIS FILE TO ".env" and fill in the blanks.
# .env is for SECRETS and is filled ONCE. NEVER commit .env (add it to .gitignore).
# All keys stay on YOUR machine — Traigent's cloud never receives your provider keys.

# ---- Traigent portal (run tracking / online optimization) --------------------
# From portal.traigent.ai -> (your name, top-right) -> API Keys -> + Create API Key.
# Shown once. May begin with uk_ or sk_ — paste it exactly as shown.
TRAIGENT_API_KEY=

# ---- One key, many vendors (recommended: open-source + low-cost) -------------
# OpenRouter reaches dozens of vendors (incl. open-source) through one key, and
# meters real cost. ⚠️ FUND THE ACCOUNT (a few $) — a free-tier key returns
# HTTP 402 on PAID models and silently fails most trials.
# NOTE: hints stay on their own comment lines. python-dotenv parses a blank
# value followed by an inline "# hint" as the literal value '# hint', so an
# unfilled key with a trailing comment reads as a configured (garbage) key.
# OPENROUTER_API_KEY: sk-or-v1-...  -> openrouter/<vendor>/<model>
OPENROUTER_API_KEY=

# ---- Direct provider keys (add any you have; mix vendors + price tiers) ------
# ANTHROPIC_API_KEY:    claude-*        (premium tier)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY:       gpt-*           (premium / mid)
OPENAI_API_KEY=
# GEMINI_API_KEY:       gemini-*        (mid)   (or GOOGLE_API_KEY)
GEMINI_API_KEY=
# GROQ_API_KEY:         groq/*          (very fast, low cost)
GROQ_API_KEY=
# TOGETHER_API_KEY:     together_ai/*   (open-source)
TOGETHER_API_KEY=
# FIREWORKS_AI_API_KEY: fireworks_ai/*  (open-source, low cost)
FIREWORKS_AI_API_KEY=
# DEEPSEEK_API_KEY:     deepseek/*      (very low cost)
DEEPSEEK_API_KEY=
# AWS Bedrock: set standard AWS credentials (AWS_ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _REGION) for bedrock/* models

# Aim for at least one premium, two mid-tier, and two low-cost / open-source
# models across different vendors. Variety is the single biggest cost lever.
